{
  "name": "express-monorepo",
  "version": "1.0.0",
  "description": "setup for development of express 5 and its dependencies in a monorepo",
  "main": "index.js",
  "homepage": "https://github.com/jchip/express-monorepo",
  "license": "ISC",
  "scripts": {
    "bootstrap": "sh init.sh && fynpo bootstrap",
    "test": "fynpo run test --stream",
    "nuke": "rm -rf */*/node_modules node_modules .fynpo */*/fyn-lock.yaml",
    "nuke-all": "rm -rf expressjs jshttp packages pillarjs node_modules .fynpo"
  },
  "private": true,
  "author": "Joel Chen",
  "files": [
    "src",
    "lib",
    "dist"
  ],
  "keywords": [
    "express",
    "monorepo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jchip/express-monorepo.git"
  },
  "devDependencies": {
    "fyn": "^3.0.0",
    "fynpo": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
